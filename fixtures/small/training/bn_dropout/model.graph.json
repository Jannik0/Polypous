{
  "format": "polypous.graph",
  "format_version": 1,
  "name": "bn_dropout",
  "opsets": {
    "core": 1,
    "nn": 1
  },
  "dims": {
    "batch": {}
  },
  "inputs": [
    {
      "name": "x",
      "dtype": "float",
      "shape": [
        "batch",
        2,
        4,
        4
      ]
    }
  ],
  "outputs": [
    {
      "name": "y",
      "value": "head"
    }
  ],
  "params": [
    {
      "name": "conv.weight",
      "dtype": "float",
      "shape": [
        3,
