    {
      "name": "bn.running_mean",
      "dtype": "float",
      "shape": [
        3
      ]
    },
    {
      "name": "bn.running_var",
      "dtype": "float",
      "shape": [
        3
      ]
    },
    {
      "name": "bn.weight",
      "dtype": "float",
      "shape": [
        3
      ]
    },
    {
      "name": "bn.bias",
      "dtype": "float",
      "shape": [
        3
      ]
    },
    {
      "name": "fc.weight",
      "dtype": "float",
      "shape": [
        6,
        48
      ]
    },
    {
      "name": "fc.bias",
      "dtype": "float",
      "shape": [
